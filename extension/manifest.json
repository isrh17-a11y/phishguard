{
  "manifest_version": 3,
  "name": "PhishGuard",
  "version": "1.0.0",
  "description": "Real-time phishing protection: scans every page you visit with an ML risk engine and blocks dangerous ones.",
  "permissions": ["webNavigation", "storage", "tabs", "contextMenus"],
  "host_permissions": ["http://localhost:8000/*", "https://phishguard-production-7b6e.up.railway.app/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "PhishGuard" },
  "web_accessible_resources": [
    { "resources": ["blocked.html"], "matches": ["<all_urls>"] }
  ]
}